{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildContext": ".",
      "watchPatterns": [
        "Dockerfile",
        "ssh-user-config.sh",
        "src-sync.sh",
        "xd-welcome.sh",
        "config.json",
        "static/favicon.svg",
        "static/favicon.ico",
        "static/patch-favicon.py"
      ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/ssh-user-config.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckTimeout": 150,
    "sleepApplicationStop": true,
    "multiRegion": false
  }
}
